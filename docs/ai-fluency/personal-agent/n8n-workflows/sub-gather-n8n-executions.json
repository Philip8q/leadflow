    {
      "id": "aggregate",
      "name": "Aggregate Executions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "const sinceMs = Date.now() - 7 * 24 * 60 * 60 * 1000;\nlet n8n_ok = true;\nlet error = null;\nlet byWorkflow = {};\nlet failures = [];\nlet total = 0;\nlet truncated = false;\n\nconst workflowsResp = $('List Workflows').first().json;\nconst pages = ['List Executions Page 1', 'List Executions Page 2', 'List Executions Page 3']\n  .map(name => $(name).first().json);\n\nif (workflowsResp && workflowsResp.error) {\n  n8n_ok = false;\n  error = 'Could not list workflows: ' + JSON.stringify(workflowsResp.error);\n} else if (pages[0] && pages[0].error) {\n  n8n_ok = false;\n  error = 'Could not list executions: ' + JSON.stringify(pages[0].error);\n} else {\n  try {\n    const nameById = {};\n    for (const w of (workflowsResp.data || [])) nameById[w.id] = w.name;\n\n    let allExecutions = [];\n    for (const p of pages) {\n      if (p && Array.isArray(p.data)) allExecutions = allExecutions.concat(p.data);\n    }\n\n    const lastPage = pages[pages.length - 1];\n    const oldestFetched = allExecutions.length\n      ? new Date(allExecutions[allExecutions.length - 1].startedAt).getTime()\n      : Date.now();\n    if (lastPage && lastPage.nextCursor && oldestFetched >= sinceMs) {\n      truncated = true; // fetched pages still didn't reach 7 days back\n    }\n\n    const recent = allExecutions.filter(e => new Date(e.startedAt).getTime() >= sinceMs);\n    total = recent.length;\n\n    for (const e of recent) {\n      const name = nameById[e.workflowId] || e.workflowId;\n      if (!byWorkflow[name]) byWorkflow[name] = { success: 0, error: 0 };\n      if (e.status === 'success') {\n        byWorkflow[name].success++;\n      } else {\n        byWorkflow[name].error++;\n        failures.push({ workflow: name, executionId: e.id, startedAt: e.startedAt, status: e.status });\n      }\n    }\n  } catch (e) {\n    n8n_ok = false;\n    error = e.message;\n  }\n}\n\nreturn [{ json: { n8n_ok, error, total_executions: total, by_workflow: byWorkflow, failures, truncated } }];"
      }
    }
  ],
