    {
      "parameters": {
        "jsCode": "const src = $('Filter Active').all().find(i => i.json.method === 'rss');\nconst entries = $input.all();\nif (!entries.length || !entries[0].json || Object.keys(entries[0].json).length === 0) {\n  return [{ json: { source_name: src ? src.json.source_name : 'unknown', url: src ? src.json.url : '', fetched_at: new Date().toISOString(), raw_text: '', status: 'empty' } }];\n}\nconst top = entries.slice(0, 5);\nconst text = top.map(i => (i.json.title || '') + '. ' + (i.json.contentSnippet || i.json.content || i.json.summary || '')).join('\\n\\n').replace(/\\s+/g, ' ').trim();\nreturn [{ json: { source_name: src ? src.json.source_name : 'unknown', url: src ? src.json.url : '', fetched_at: new Date().toISOString(), raw_text: text.slice(0, 4000), status: text ? 'ok' : 'empty' } }];"
      },
