# Base URL used by Server Components that need to build absolute URLs
# (e.g. the health-check page fetching its own API route).
# Vercel sets VERCEL_URL automatically in preview/production; only set this
# locally if you're testing against something other than localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenRouter API key, used by app/api/chat/route.js (the lead-qualification
# chat demo) to call a free-tier model via @openrouter/ai-sdk-provider.
# Required both locally and on the Vercel deployment (set it in Project
# Settings > Environment Variables there too). Create one (no card required
# for free-tier models) at https://openrouter.ai/keys
OPENROUTER_API_KEY=
