# Base URL used by Server Components that need to build absolute URLs
# (e.g. the health-check page fetching its own API route).
# Vercel sets VERCEL_URL automatically in preview/production; only set this
# locally if you're testing against something other than localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel AI Gateway key, used by app/api/chat/route.js (the lead-qualification
# chat demo) to call the model. On a Vercel deployment this can also be left
# unset if the project has OIDC enabled (Project Settings > General), since
# the Gateway then authenticates automatically. Locally, OIDC isn't
# available, so this key is required to test the chat on localhost. Create
# one at https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai%2Fapi-keys
AI_GATEWAY_API_KEY=
